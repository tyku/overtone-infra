# Copy to .env and replace every change_me value. Never commit .env.
STACK_NAME=overtone

# Independently versioned immutable image references. Run `make versions` to
# calculate each content version. Shared version tags and `latest` are rejected.
GATEWAY_IMAGE=ghcr.io/tyku/overtone-gateway:change_me_gateway_version
FRONTEND_IMAGE=ghcr.io/tyku/overtone-frontend:change_me_frontend_version
BACKEND_IMAGE=ghcr.io/tyku/overtone-backend:change_me_backend_version
SWARM_CHECK_IMAGE=ghcr.io/tyku/overtone-swarm-check:change_me_swarm_check_version

# Public edge. Put real DNS here. ADMIN_ALLOW_RULES is literal nginx syntax.
PUBLIC_SERVER_NAME=localhost
ADMIN_ALLOW_RULES='allow 127.0.0.1/32; allow 10.0.0.0/8; deny all;'
HTTP_PORT=80
HTTPS_PORT=443
KUMA_PORT=3001

# External services. They are deliberately not Docker Swarm service names.
S3_ENDPOINT=http://10.0.0.10:9000
S3_REGION=us-east-1
S3_BUCKET=medical-scribe
INFERENCE_GRPC_ADDRESS=10.0.0.12:15051
INFERENCE_GRPC_TLS=false
INFERENCE_LLM_BACKEND=LOCAL
INFERENCE_SPECIALTY=

# Node hostnames from `docker node ls`. API/Redis may share one worker.
API_NODE=worker-1
REDIS_NODE=worker-1
INFERENCE_NODE=worker-2

# Versioned external Docker secret names. Rotate by creating a new name.
DATABASE_URL_SECRET=overtone_database_url_v1
WORKER_DATABASE_URL_SECRET=overtone_worker_database_url_v1
S3_ACCESS_KEY_ID_SECRET=overtone_s3_access_key_id_v1
S3_SECRET_ACCESS_KEY_SECRET=overtone_s3_secret_access_key_v1
REDIS_PASSWORD_SECRET=overtone_redis_password_v1
TLS_CERT_SECRET=overtone_tls_cert_v1
TLS_KEY_SECRET=overtone_tls_key_v1
UPTIME_PUSH_URL_SECRET=overtone_uptime_push_url_v1

# Values below are consumed only by scripts/deploy.sh when a named secret does
# not exist yet. Existing secrets are never overwritten or printed.
DATABASE_URL=postgresql://overtone:change_me@10.0.0.10:5432/overtone
WORKER_DATABASE_URL=postgresql://overtone:change_me@10.0.0.10:5432/overtone
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
REDIS_PASSWORD=change_me
TLS_CERT_FILE=./local-certs/tls.crt
TLS_KEY_FILE=./local-certs/tls.key
# Create a Push monitor in Uptime Kuma and paste its complete push URL.
UPTIME_PUSH_URL=http://uptime-kuma:3001/api/push/change_me

# Application limits (kept in sync with the current Overtone backend/Nginx).
SESSION_TTL_HOURS=12
MAX_UPLOAD_BYTES=1073741824
MAX_AUDIO_PARTS=1000
FFMPEG_TIMEOUT_MS=1800000
HTTP_UPLOAD_TIMEOUT_MS=2100000

# Local external Compose only.
POSTGRES_USER=overtone
POSTGRES_PASSWORD=change_me
POSTGRES_DB=overtone
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=overtone_external_postgres_data_v1
MEDSCRIBE_DATABASE_USER=medscribe
MEDSCRIBE_DATABASE_PASSWORD=change_me
MEDSCRIBE_DATABASE_NAME=medscribe
S3_PORT=9000
S3_CONSOLE_PORT=9001
MINIO_VOLUME_NAME=overtone_external_minio_data_v1
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me
INFERENCE_PORT=50051
MEDICAL_SCRIBE_DIR=../../medical-scribe
