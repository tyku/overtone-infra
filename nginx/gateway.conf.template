limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
resolver 127.0.0.11 valid=10s ipv6=off;

upstream overtone_frontend {
    zone frontend 64k;
    server frontend:8080 resolve;
}

upstream overtone_api {
    zone api 64k;
    server api:3000 resolve;
}

server {
    listen 80;
    server_name ${PUBLIC_SERVER_NAME};

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /admin { return 404; }
    location ^~ /admin/ { return 404; }
    location = /api/admin { return 404; }
    location ^~ /api/admin/ { return 404; }
    location ~* ^/(?:api/)?admin(?:/|$) { return 404; }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_SERVER_NAME};

    ssl_certificate /run/secrets/tls_crt;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 1025m;
    client_body_timeout 300s;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/admin/ {
        return 404;
    }

    location = /api/admin {
        return 404;
    }

    location = /admin {
        return 404;
    }

    location ^~ /admin/ {
        return 404;
    }

    location ~* ^/(?:api/)?admin(?:/|$) {
        return 404;
    }

    include /etc/nginx/shared-locations.conf;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${ADMIN_SERVER_NAME};

    if ($host != ${ADMIN_SERVER_NAME}) {
        return 421;
    }

    ssl_certificate /run/secrets/tls_crt;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    allow ${ADMIN_BASTION_CIDR};
    deny all;

    location = /api/admin {
        include /etc/nginx/proxy_params;
        proxy_pass http://overtone_api;
    }

    location ^~ /api/admin/ {
        include /etc/nginx/proxy_params;
        proxy_pass http://overtone_api;
        proxy_request_buffering off;
        proxy_read_timeout 2100s;
        proxy_send_timeout 2100s;
    }

    location = /admin {
        proxy_pass http://overtone_frontend;
    }

    location ^~ /admin/ {
        return 404;
    }

    include /etc/nginx/shared-locations.conf;
}
